load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_cc//cc:defs.bzl", "objc_library")

objc_library(
    name = "macos_app_lib",
    srcs = glob([
        "*.h",
        "*.m",
    ]) + [
        "//platform/darwin:app/MBXArcticProjection.h",
        "//platform/darwin:app/MBXArcticProjection.m",
    ],
    copts = ["-Iplatform/darwin/app"],
    enable_modules = True,
    deps = [
        "//platform:macos-sdk",
    ],
)

macos_application(
    name = "macos_app",
    bundle_id = "org.maplibre.macosapp",
    infoplists = [
        "Info.plist",
    ],
    minimum_os_version = "14.3",
    resources = glob([
        "*.lproj/**",
        "Assets.xcassets/**",
    ]) + [
        "//platform/glfw:assets/arctic.json",
    ],
    visibility = [
        "@rules_xcodeproj//xcodeproj:generated",
    ],
    deps = [
        ":macos_app_lib",
    ],
)
